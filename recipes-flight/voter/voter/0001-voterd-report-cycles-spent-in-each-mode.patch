From 2ba57662a3a299055be8fdf503ccee6d34b06dad Mon Sep 17 00:00:00 2001
From: Khiem Tang <khttang@gmail.com>
Date: Tue, 20 Oct 2026 05:42:07 +0000
Subject: [PATCH] voterd: report cycles spent in each mode

Upstream-Status: Pending
---
 src/voterd.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/voterd.cpp b/src/voterd.cpp
index 140d751..7c9aea1 100644
--- a/src/voterd.cpp
+++ b/src/voterd.cpp
@@ -4,7 +4,7 @@
 // A field of "-" means the channel's built-in test failed (valid = false); "nan" is accepted.
 // Output goes to stdout, which systemd sends to the journal: mode changes, latches, errors,
 // and a summary on SIGTERM.
-//
+// Testing
 // voterd [port]    default port 5005, bound to 127.0.0.1 only
 
 #include "voter.hpp"
@@ -91,6 +91,7 @@ int main(int argc, char** argv) {
     Mode last_mode = Mode::Triplex;
     double last_good = 0.0;
     unsigned long cycle = 0, errors = 0;
+    std::array<unsigned long, 3> in_mode{};   // cycles spent in Triplex, Duplex, Simplex
 
     while (!g_stop) {
         char buf[256];
@@ -115,6 +116,7 @@ int main(int argc, char** argv) {
             have_mode = true;
             last_mode = r->mode;
             last_good = r->value;
+            ++in_mode[static_cast<std::size_t>(r->mode)];
         } else {
             ++errors;
             std::printf("cycle %lu: %s, holding %.2f m\n", cycle, error_name(r.error()), last_good);
@@ -129,6 +131,7 @@ int main(int argc, char** argv) {
 
     std::printf("voterd: stopping after %lu cycles, %lu errors, latched A=%d B=%d C=%d\n", cycle, errors,
                 voter.latched(0), voter.latched(1), voter.latched(2));
+    std::printf("voterd: cycles in Triplex=%lu Duplex=%lu Simplex=%lu\n", in_mode[0], in_mode[1], in_mode[2]);
     close(fd);
     return 0;
 }
